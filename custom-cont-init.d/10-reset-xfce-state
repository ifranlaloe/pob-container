#!/usr/bin/with-contenv bash
set -euo pipefail

config_root=/config/.config
xfce_directory="${config_root}/xfce4"
panel_directory="${xfce_directory}/xfconf/xfce-perchannel-xml"
panel_config="${panel_directory}/xfce4-panel.xml"
marker=/config/.pob-xfce-clean-state-v1

# The existing configuration originated on another Webtop distribution. Start
# Alpine from a known-good XFCE state instead, without touching Wine, PoB, or
# saved profiles.
if [[ ! -e "${marker}" ]]; then
    rm -rf "${xfce_directory}"
    mkdir -p "${panel_directory}"
    cp /opt/pob-xfce/xfce4-panel.xml "${panel_config}"
    touch "${marker}"
    chown -R abc:abc "${xfce_directory}" "${marker}"
    echo "[pob] Replaced the old XFCE state with a clean Alpine desktop and Whisker application menu."
fi
